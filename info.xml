<?xml version="1.0"?>
<extension key="com.joineryhq.msgtplmerge" type="module">
  <file>msgtplmerge</file>
  <name>Message Template Merge API</name>
  <description>Provides a "merge" action on the MessageTemplate API, to allow programmatic execution of the "Print/Merge Document" functionality for a given contact.</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.msgtplmerge</url>
    <url desc="Documentation">https://github.com/twomice/com.joineryhq.msgtplmerge</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.msgtplmerge/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2021-04-20</releaseDate>
  <version>0.2.1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Msgtplmerge</namespace>
    <format>25.10.2</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
</extension>
